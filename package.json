{
  "name": "lembrei-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:local": "wrangler d1 migrations apply lembrei_bot --local",
    "db:remote": "wrangler d1 migrations apply lembrei_bot --remote",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260712.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.110.0"
  },
  "engines": {
    "node": ">=24"
  }
}
